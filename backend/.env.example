NODE_ENV=development
PORT=3001

# Pooled — usada pela aplicação em runtime. Nunca a URL real neste arquivo.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Direta (sem pooler) — usada só pelo TypeORM CLI (migration:generate/run/revert).
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Origem exata do frontend liberada no CORS — nunca "*" (o backend usa
# credentials:true para o cookie de sessão).
FRONTEND_URL="http://localhost:3000"

# Endereço de escuta (opcional). Ausente: todas as interfaces, como antes.
# No Render é 0.0.0.0, definido em render.yaml.
# HOST=0.0.0.0

# Fonte do IP do cliente no rate limit: socket (padrão) ou cf-connecting-ip.
# Nunca ligar cf-connecting-ip fora de uma hospedagem que garanta esse
# cabeçalho (ver docs/runbooks/publicacao-piloto-render.md).
# CLIENT_IP_SOURCE=socket
