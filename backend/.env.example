NODE_ENV=development
PORT=3001

# Pooled — usada pela aplicação em runtime. Nunca a URL real neste arquivo.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Direta (sem pooler) — usada só pelo TypeORM CLI (migration:generate/run/revert).
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Origem exata do frontend liberada no CORS — nunca "*" (o backend usa
# credentials:true para o cookie de sessão).
FRONTEND_URL="http://localhost:3000"
