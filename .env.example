DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO"

# Endereço do backend NestJS real (Lote 6C.1) — nunca aponte para produção
# num arquivo de exemplo; em desenvolvimento local o backend roda na 3001.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Modo mesma origem (o do piloto no Render): o navegador chama o próprio
# frontend em /agenda_api, e o servidor do Next.js encaminha à API. Para usar
# localmente, troque NEXT_PUBLIC_API_URL por "/agenda_api" (exige novo build)
# e defina as variáveis de SERVIDOR abaixo (nunca NEXT_PUBLIC_*).
# API_PROXY_TARGET="http://localhost:3001"
# APP_PUBLIC_ORIGIN="http://localhost:3000"
# Mesmo valor de API_PROXY_SECRET do backend (mínimo de 32 caracteres).
# API_PROXY_SECRET=
# socket (padrão: nenhum IP repassado) ou cf-connecting-ip (só atrás de uma
# borda que sobrescreva esse cabeçalho; ver o runbook do piloto).
# CLIENT_IP_SOURCE=socket
