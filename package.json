    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "playwright test",
