    "test:browser:acesso-usuario": "playwright test tests/browser/acesso-por-usuario-flow.spec.ts",
    "test:browser:gerente": "playwright test tests/browser/gerente-acessos-flow.spec.ts",
    "test:browser:calendario-funcionario": "playwright test tests/browser/calendario-funcionario-flow.spec.ts",
