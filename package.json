{
  "name": "agenda-barber",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "playwright test",
    "test:browser:auth": "playwright test tests/browser/auth-cookie-flow.spec.ts tests/browser/registration-flow.spec.ts",
    "test:browser:services": "playwright test tests/browser/services-flow.spec.ts",
    "test:browser:professionals": "playwright test tests/browser/professionals-flow.spec.ts",
    "test:browser:working-hours": "playwright test tests/browser/professional-working-hours-flow.spec.ts",
    "test:browser:availability": "playwright test tests/browser/availability-flow.spec.ts",
    "test:browser:appointments": "playwright test tests/browser/appointments-flow.spec.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
